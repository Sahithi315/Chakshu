# ==============================================================================
# Chakshu — Environment Configuration & LLM Failover Routing
# ==============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# HARD SAFETY CONTRACT:
# - Keys must come ONLY from environment variables (never committed to git).
# - Direct identifiers (name, phone, MRN) are never sent to external LLMs.
# - The system never diagnoses, suggests causes, or recommends treatment.
# - If all providers fail or are unconfigured, Chakshu falls back silently to:
#     * Patient Chatbot  -> Structured Intake Form (pre-filled)
#     * Doctor Summary   -> Deterministic Evidence-Linked Template
# ==============================================================================

# LLM Provider Failover Order (comma-separated, tried left-to-right)
# Providers without configured API keys are automatically skipped.
LLM_PROVIDER_ORDER=anthropic,gemini,openai

# ------------------------------------------------------------------------------
# 1. Anthropic (Claude)
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-haiku-20240307

# ------------------------------------------------------------------------------
# 2. Google (Gemini)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 3. OpenAI (GPT)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# Failover & Timeout Controls
# ------------------------------------------------------------------------------
# Maximum timeout for a single provider call (seconds)
LLM_PER_PROVIDER_TIMEOUT=6.0

# Total latency budget across all provider failover attempts (seconds)
LLM_TOTAL_BUDGET=12.0

# Cooldown duration after a RateLimit (429) error (seconds)
LLM_COOLDOWN_SECONDS=60.0

# Cooldown duration after a Quota Exhausted error (seconds)
LLM_QUOTA_COOLDOWN_SECONDS=3600.0

# ------------------------------------------------------------------------------
# Chatbot Configuration
# ------------------------------------------------------------------------------
# Hard cap on number of questions asked during patient intake (target: 3-5)
MAX_CHAT_QUESTIONS=6

# ------------------------------------------------------------------------------
# Staff Demo Passwords (optional overrides for demo accounts)
# ------------------------------------------------------------------------------
CHAKSHU_DOCTOR_PASSWORD=Doctor123!
CHAKSHU_NURSE_PASSWORD=Nurse123!
